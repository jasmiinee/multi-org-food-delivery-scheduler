{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/cs3263/food-delivery-instance.schema.json",
  "title": "Multi-Organisation Food Delivery Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "parameters",
    "organisations",
    "households",
    "volunteers",
    "vehicles",
    "requests",
    "duplicate_households",
    "travel_times"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "difficulty", "scenario", "seed", "generator_version", "cold_chain_time_limit_enabled"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "difficulty": {"enum": ["worked_example", "easy", "medium", "hard"]},
        "scenario": {"enum": ["fully_serviceable", "partially_serviceable"]},
        "seed": {"type": "integer"},
        "generator_version": {"type": "string"},
        "cold_chain_time_limit_enabled": {"const": false}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_minutes", "loading_minutes", "time_unit", "window_semantics", "max_trips_per_vehicle"],
      "properties": {
        "service_minutes": {"type": "integer", "minimum": 1},
        "loading_minutes": {"type": "integer", "minimum": 0},
        "time_unit": {"const": "minutes_from_midnight"},
        "window_semantics": {"const": "service_start"},
        "max_trips_per_vehicle": {"const": 1}
      }
    },
    "organisations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/organisation"}
    },
    "households": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/household"}
    },
    "volunteers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/volunteer"}
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/vehicle"}
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/request"}
    },
    "duplicate_households": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["household", "competing_requests"],
        "properties": {
          "household": {"type": "string"},
          "competing_requests": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        }
      }
    },
    "travel_times": {
      "type": "object",
      "description": "Complete symmetric matrix represented as origin -> destination -> whole minutes.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end"],
      "properties": {
        "id": {"type": "string"},
        "start": {"type": "integer", "minimum": 0, "maximum": 1439},
        "end": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    },
    "organisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depot", "shifts"],
      "properties": {
        "id": {"type": "string"},
        "depot": {"type": "string"},
        "shifts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shift"}
        }
      }
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "needs_trained_volunteer", "priority"],
      "properties": {
        "id": {"type": "string"},
        "needs_trained_volunteer": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "volunteer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organisation", "role", "shift_id", "trained", "vehicle_id"],
      "properties": {
        "id": {"type": "string"},
        "organisation": {"type": "string"},
        "role": {"enum": ["driver", "assistant"]},
        "shift_id": {"type": "string"},
        "trained": {"type": "boolean"},
        "vehicle_id": {"type": ["string", "null"]}
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organisation", "home_depot", "driver_id", "seats", "ambient_capacity", "chilled_capacity"],
      "properties": {
        "id": {"type": "string"},
        "organisation": {"type": "string"},
        "home_depot": {"type": "string"},
        "driver_id": {"type": "string"},
        "seats": {"type": "integer", "minimum": 1},
        "ambient_capacity": {"type": "integer", "minimum": 0},
        "chilled_capacity": {"type": "integer", "minimum": 0}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organisation",
        "household",
        "depot",
        "ambient_crates",
        "chilled_crates",
        "window_start",
        "window_end"
      ],
      "properties": {
        "id": {"type": "string"},
        "organisation": {"type": "string"},
        "household": {"type": "string"},
        "depot": {"type": "string"},
        "ambient_crates": {"type": "integer", "minimum": 0},
        "chilled_crates": {"type": "integer", "minimum": 0},
        "window_start": {"type": "integer", "minimum": 0, "maximum": 1439},
        "window_end": {"type": "integer", "minimum": 0, "maximum": 1439}
      }
    }
  }
}

